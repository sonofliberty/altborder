      "html": "<svg class=\"ds-map\" viewBox=\"0 0 320 160\" role=\"img\" aria-label=\"Political map style sample\"><rect width=\"320\" height=\"160\"/><path d=\"M55 28 L190 18 L258 60 L236 131 L117 144 L45 100 Z\"/><text x=\"155\" y=\"84\" text-anchor=\"middle\">COUNTRY</text></svg>",
      "css": ".ds-map{display:block;width:100%;max-width:480px;background:var(--color-map-ocean)}.ds-map rect{fill:var(--color-map-ocean)}.ds-map path{fill:#85887b;stroke:var(--color-map-country-border);stroke-width:1.55;stroke-linejoin:round;vector-effect:non-scaling-stroke}.ds-map text{font-family:var(--font-map-country);font-size:18px;font-weight:700;letter-spacing:1px;fill:var(--color-map-label);stroke:var(--color-map-label-outline);stroke-width:.1em;stroke-linejoin:round;paint-order:stroke fill}"
    }
