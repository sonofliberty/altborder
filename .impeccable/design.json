  "components": [
    {
      "name": "Editor standard button",
      "kind": "button",
      "refersTo": "editor-button",
      "description": "Existing editor action.",
      "html": "<button class=\"ds-button\">Present map</button>",
      "css": ".ds-button{font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:var(--control-height,38px);padding:0 11px;border:1px solid var(--color-border-strong);border-radius:4px;background:var(--color-surface-elevated);color:var(--color-text);cursor:pointer;transition:background-color 130ms ease,border-color 130ms ease,color 130ms ease}.ds-button:hover{background:var(--color-surface-muted);border-color:var(--color-primary)}.ds-button:active{background:var(--color-primary-soft)}.ds-button:focus-visible{outline:3px solid var(--color-focus);outline-offset:2px}.ds-button:disabled{opacity:.54;cursor:not-allowed}"
    },
    {
