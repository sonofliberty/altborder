      "html": "<button class=\"ds-button ds-primary\">Share</button>",
      "css": ".ds-button{font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:var(--control-height,38px);padding:0 11px;border:1px solid var(--color-border-strong);border-radius:4px;background:var(--color-surface-elevated);color:var(--color-text);cursor:pointer;transition:background-color 130ms ease,border-color 130ms ease,color 130ms ease}.ds-button:hover{background:var(--color-surface-muted);border-color:var(--color-primary)}.ds-button:active{background:var(--color-primary-soft)}.ds-button:focus-visible{outline:3px solid var(--color-focus);outline-offset:2px}.ds-button:disabled{opacity:.54;cursor:not-allowed}.ds-primary{background:var(--color-primary);border-color:var(--color-primary);color:var(--color-primary-ink);font-weight:700}.ds-primary:hover{background:var(--color-primary-hover);border-color:var(--color-primary-hover)}.ds-primary:active{background:var(--color-primary)}"
    },
    {
      "name": "Editor text field",
